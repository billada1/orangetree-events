---
// Print-only brochure pages (noindex, not in the sitemap). PDFs are made by scripts/brochures.mjs.
import Brochure from '../../components/Brochure.astro';
export function getStaticPaths() {
  return (['artists', 'sponsors'] as const).flatMap((kind) => (['en', 'tr'] as const).map((lang) => ({ params: { doc: `${kind}-${lang}` }, props: { kind, lang } })));
}
const { kind, lang } = Astro.props;
---
<Brochure kind={kind} lang={lang} />
