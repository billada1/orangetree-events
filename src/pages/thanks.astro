---
import SimplePage from '../components/SimplePage.astro';
---
<SimplePage lang="en" title="Thank you" noindex={true}>
  <p data-ok>You're on the list. Check your inbox to confirm your email, then you'll hear about new shows first.</p>
  <p><a href="/">Back to the home page</a></p>
  <p data-sent hidden>Thanks, your enquiry is with us. We’ll read it and reply by email. If it’s urgent, email info@orangetree.events.</p>
  <p data-err hidden>That email address didn't look right, or something went wrong on our side. Please go back and try again, or email info@orangetree.events.</p>
</SimplePage>
<script>
  const q = new URLSearchParams(location.search);
  if (q.get('sent') === 'enquiry' && !q.has('error')) {
    document.querySelector<HTMLElement>('[data-ok]')!.hidden = true;
    document.querySelector<HTMLElement>('[data-sent]')!.hidden = false;
  }
  if (q.has('error')) {
    document.querySelector<HTMLElement>('[data-ok]')!.hidden = true;
    document.querySelector<HTMLElement>('[data-err]')!.hidden = false;
  }
</script>
