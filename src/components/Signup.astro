---
// Mailing list sign-up (Brevo double opt-in via /api/subscribe/). One block reused across the site.
// `big` is the full panel for /subscribe/; the default is a compact card for the end of event and story pages.
import { t, href, type Lang } from '../i18n/ui';
interface Props { lang: Lang; id: string; big?: boolean; heading?: string; text?: string; event?: string }
const { lang, id, big = false, heading, text, event } = Astro.props;
const s = t(lang);
const tr = lang === 'tr';
const h = heading ?? (tr ? 'Hiçbir geceyi kaçırmayın' : 'Never miss a night');
const p = text ?? (tr
  ? 'Yeni konserler, yılbaşı ve erken masa fırsatları önce e-posta listemize gelir. Ayda bir civarı, Türkçe ya da İngilizce.'
  : 'New concerts, New Year’s Eve and early tables go to the mailing list first. About once a month, in English or Türkçe.');
---
<section class:list={['su', { big }]} aria-labelledby={`${id}-h`}>
  <div class="copy">
    {big ? <h1 id={`${id}-h`}>{h}</h1> : <h2 id={`${id}-h`}>{h}</h2>}
    <p>{p}</p>
    {big && (
      <ul class="why">
        <li>{tr ? 'Erken masa ve bilet fırsatları, herkesten önce' : 'Early tables and tickets, before anyone else'}</li>
        <li>{tr ? 'Desteklediğimiz topluluk geceleri ve konserler' : 'Community nights and concerts we support'}</li>
        <li>{tr ? 'Gecelerden hikâyeler ve fotoğraflar' : 'Stories and photos from the nights'}</li>
        <li>{tr ? 'İstediğiniz zaman tek tıkla ayrılın' : 'Unsubscribe any time in one click'}</li>
      </ul>
    )}
  </div>
  <form action="/api/subscribe/" method="post" class="f">
    <label for={`${id}-email`}>{s.on.email}</label>
    <div class="row">
      <input id={`${id}-email`} class="field" type="email" name="email" autocomplete="email" required placeholder={s.on.emailPh} />
      <button class="btn btn-primary" type="submit">{tr ? 'Listeye katıl' : 'Join the list'}</button>
    </div>
    {big ? (
      <fieldset class="lang">
        <legend>{tr ? 'E-postaları hangi dilde alalım?' : 'Which language should we email you in?'}</legend>
        <label><input type="radio" name="lang" value="en" checked={!tr} /> English</label>
        <label><input type="radio" name="lang" value="tr" checked={tr} /> Türkçe</label>
      </fieldset>
    ) : <input type="hidden" name="lang" value={lang} />}
    {event && <input type="hidden" name="event" value={event} />}
    <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <p class="fine">{tr ? 'Onay için size bir e-posta göndereceğiz. ' : 'We’ll email you once to confirm. '}<a href={href(lang, '/privacy/')}>{tr ? 'Gizlilik' : 'Privacy'}</a></p>
  </form>
</section>
<style>
  .su { display: grid; grid-template-columns: 1.1fr 1fr; gap: 28px 40px; align-items: center; padding: 28px; border: 1px solid var(--line); border-radius: 24px;
    background: radial-gradient(80% 120% at 100% 0%, rgba(240,90,40,.16), transparent 60%), rgba(255,255,255,.02); }
  .su h2 { font-size: clamp(24px, 3vw, 32px); margin: 0 0 8px; }
  .su h1 { font-size: clamp(36px, 6vw, 64px); line-height: 1; margin: 0 0 14px; }
  .copy p { margin: 0; color: var(--ink-2); }
  .why { margin: 18px 0 0; padding-left: 1.2em; display: grid; gap: 8px; color: var(--ink-2); }
  .why li::marker { color: var(--accent); }
  .f label[for] { display: block; font-weight: 600; font-size: 14px; margin-bottom: 8px; }
  .row { display: flex; flex-wrap: wrap; gap: 8px; }
  .row .field { flex: 1 1 220px; }
  .lang { border: 0; padding: 0; margin: 14px 0 0; display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 15px; }
  .lang legend { font-size: 14px; color: var(--muted); margin-bottom: 6px; padding: 0; width: 100%; }
  .lang label { display: inline-flex; align-items: center; gap: 8px; min-height: 24px; cursor: pointer; }
  .lang input { accent-color: var(--accent); width: 18px; height: 18px; }
  .fine { font-size: 13px; color: var(--muted); margin: 10px 0 0; }
  .fine a { text-decoration: underline; }
  .big { padding: clamp(28px, 5vw, 56px); }
  @media (max-width: 820px) { .su { grid-template-columns: 1fr; padding: 22px; } .big { padding: 26px 20px; } }
</style>
