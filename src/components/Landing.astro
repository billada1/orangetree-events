---
// Search landing pages (Turkish concerts in Sydney, Turkish New Year's Eve in Sydney), built from the events and artists data.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { events, upcoming, past, eventBySlug, isUpcoming, type EventItem } from '../data/events';
import { artistBySlug } from '../data/artists';
import { artistImage, posterFor } from '../data/media';
import { photos } from '../data/photos';
import { eventJsonLd } from '../data/schema';
import { landing, type Topic } from '../i18n/landing';
import { t, href, fmtDate, type Lang } from '../i18n/ui';
interface Props { lang: Lang; topic: Topic }
const { lang, topic } = Astro.props;
const c = landing[topic][lang];
const s = t(lang);
const site = Astro.site!;

const isNye = topic === 'nye';
const up = upcoming().filter((e) => (isNye ? e.kind === 'nye' : e.kind !== 'nye'));
const extra = isNye ? [] : upcoming().filter((e) => e.kind === 'nye');
const hist = (isNye ? past().filter((e) => e.kind === 'nye') : past().filter((e) => e.kind === 'presented'))
  .sort((a, b) => (b.date ?? b.year ?? '').localeCompare(a.date ?? a.year ?? ''));
const artistSlugs = [...new Set((isNye ? events.filter((e) => e.kind === 'nye') : events.filter((e) => e.kind !== 'nye' && !isUpcoming(e))).flatMap((e) => e.artists ?? []))];
const people = artistSlugs.map(artistBySlug).filter(Boolean).map((a) => ({ a: a!, img: artistImage(a!) }))
  .sort((x, y) => Number(!!y.img) - Number(!!x.img));
const faq = c.faq.filter((f) => !f.ev || (eventBySlug(f.ev) && isUpcoming(eventBySlug(f.ev)!)));
const hero = photos[isNye ? 'nye2025stage' : 'heroStage'];
const when = (e: EventItem) => (e.date ? fmtDate(e.date, lang, { weekday: true }) + (e.doors ? ` · ${s.on.doors} ${e.doors.replace(':', lang === 'tr' ? '.' : ':')}` : '') : e.year ?? '');
const url = new URL(href(lang, c.slug), site).href;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: s.siteName, item: new URL(href(lang, '/'), site).href },
    { '@type': 'ListItem', position: 2, name: c.crumb, item: url },
  ] },
  ...[...up, ...extra].map((e) => eventJsonLd(e, lang, site)).filter(Boolean),
] as object[];
---
<Base lang={lang} title={c.title} description={c.meta} jsonLd={jsonLd}>
  <section class="top">
    <Image src={hero.src} alt="" widths={[480, 768, 1024, 1600]} sizes="100vw" quality={70} class="bg" loading="eager" fetchpriority="high" />
    <div class="shade" aria-hidden="true"></div>
    <div class="wrap in">
      <nav class="crumbs" aria-label={lang === 'tr' ? 'Konum' : 'Breadcrumb'}><a href={href(lang, '/')}>{s.siteName}</a> <span aria-hidden="true">/</span> <span aria-current="page">{c.crumb}</span></nav>
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.h1}</h1>
      <p class="lead">{c.lead}</p>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="up-h">
    <h2 id="up-h" class="h2">{c.upH}</h2>
    {up.length || extra.length ? (
      <ul class="cards">
        {[...up, ...extra].map((e) => {
          const p = posterFor(e);
          return (
            <li class="card ev">
              <a href={href(lang, `/events/${e.slug}/`)} class="ev-a">
                {p ? <Image src={p} alt="" widths={[200, 400]} sizes="120px" class="ev-p" /> : <span class="ev-p ev-p0" aria-hidden="true"><img src="/emblem.svg" alt="" width="40" height="46" /></span>}
                <span class="ev-t">
                  <span class={`badge badge-${e.kind}`}>{s.kinds[e.kind]}</span>
                  <span class="ev-n">{e.title[lang]}</span>
                  <span class="muted">{when(e)}</span>
                  <span class="muted">{e.venue}</span>
                  {e.tickets && <span class="price">{e.tickets.label[lang]}</span>}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    ) : <p class="lead">{c.upNone}</p>}
  </section>

  {people.length > 0 && (
    <section class="wrap block" aria-labelledby="ar-h">
      <h2 id="ar-h" class="h2">{c.artistsH}</h2>
      <ul class="people">
        {people.map(({ a, img }) => (
          <li><a href={href(lang, `/artists/${a.slug}/`)}>
            {img ? <Image src={img.src} alt="" widths={[96, 192]} sizes="48px" class={`av fp-${a.slug}`} /> : <span class="av av0" aria-hidden="true">{a.name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('')}</span>}
            <span>{a.name}</span>
          </a></li>
        ))}
      </ul>
    </section>
  )}

  <section class="wrap block" aria-labelledby="hi-h">
    <h2 id="hi-h" class="h2">{c.histH}</h2>
    <p class="muted sub">{c.histP}</p>
    <ol class="hist">
      {hist.map((e) => (
        <li>
          <span class="y">{e.date ? fmtDate(e.date, lang, { year: true }) : e.year}</span>
          <a href={href(lang, `/events/${e.slug}/`)}>{e.title[lang]}</a>
          <span class="muted">{[e.venue, (e.artists ?? []).map((x) => artistBySlug(x)?.name).filter(Boolean).join(', ')].filter(Boolean).join(' · ')}{e.soldOut && <> · <span class="so">{s.past.soldOut}</span></>}</span>
        </li>
      ))}
    </ol>
    <p><a class="btn btn-ghost" href={href(lang, isNye ? '/events/?type=nye#past-events' : '/events/#past-events')}>{s.nav.past} →</a></p>
  </section>

  <section class="wrap block" aria-labelledby="faq-h">
    <h2 id="faq-h" class="h2">{c.faqH}</h2>
    <div class="faq">
      {faq.map((f, i) => (
        <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </div>
  </section>

  <section class="wrap block join" aria-labelledby="join-h" id="stay-in-touch">
    <div class="card jc">
      <h2 id="join-h" class="h2">{c.joinH}</h2>
      <p class="muted">{c.joinP}</p>
      <form action="/api/subscribe/" method="post" class="jf">
        <label class="sr-only" for="lp-email">{s.on.email}</label>
        <input id="lp-email" class="field" type="email" name="email" autocomplete="email" required placeholder={s.on.emailPh} />
        <input type="hidden" name="lang" value={lang} /><input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="btn btn-primary" type="submit">{s.on.notify}</button>
      </form>
    </div>
  </section>
</Base>
<style>
  .top { position: relative; min-height: 520px; height: 64vh; max-height: 720px; display: flex; align-items: flex-end; overflow: hidden; }
  .top :global(.bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(13,11,10,.6), rgba(13,11,10,.2) 35%, rgba(13,11,10,.96)); }
  .in { position: relative; width: 100%; padding-bottom: 48px; }
  .in h1 { font-size: clamp(36px, 6vw, 80px); max-width: 16ch; }
  .in .lead { max-width: 680px; margin-top: 18px; }
  .crumbs { font-size: 14px; color: var(--muted); margin-bottom: 18px; }
  .crumbs a { color: var(--ink-2); }
  .block { padding-block: 56px 8px; }
  .sub { margin: 10px 0 20px; max-width: 680px; }
  .cards { list-style: none; margin: 24px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; }
  .ev { padding: 0; overflow: hidden; }
  .ev-a { display: flex; gap: 18px; padding: 16px; text-decoration: none; height: 100%; transition: background .2s; }
  .ev-a:hover { background: #1C1815; }
  .ev :global(.ev-p) { flex: 0 0 96px; width: 96px; height: 128px; object-fit: cover; border-radius: 10px; }
  .ev-p0 { display: grid; place-items: center; background: #1C1815; } .ev-p0 img { opacity: .4; }
  .ev-t { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .ev-n { font-weight: 700; font-size: 19px; line-height: 1.25; margin-top: 6px; }
  .ev-t .badge { align-self: flex-start; }
  .price { margin-top: 6px; font-weight: 600; color: var(--peach); font-size: 15px; }
  .people { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .people a { display: inline-flex; align-items: center; gap: 10px; padding: 6px 16px 6px 6px; border: 1px solid var(--line); border-radius: 999px; text-decoration: none; font-weight: 600; font-size: 15px; transition: border-color .2s, background .2s; }
  .people a:hover { border-color: var(--peach); background: #1C1815; }
  .people :global(.av) { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; }
  .av0 { display: grid; place-items: center; background: #2A2522; color: var(--peach); font-size: 13px; font-weight: 700; }
  .hist { list-style: none; margin: 0 0 24px; padding: 0; border-top: 1px solid var(--line); }
  .hist li { display: grid; grid-template-columns: 170px 1fr; gap: 2px 20px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .hist .y { grid-row: span 2; color: var(--accent); font-weight: 700; font-size: 15px; }
  .hist a { font-weight: 600; font-size: 18px; }
  .hist .muted { font-size: 14px; }
  .so { color: var(--peach); }
  .faq { margin-top: 20px; max-width: 820px; border-top: 1px solid var(--line); }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; padding: 18px 36px 18px 0; font-weight: 600; font-size: 18px; list-style: none; position: relative; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; position: absolute; right: 4px; top: 14px; font-size: 24px; color: var(--accent); transition: transform .2s; }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq p { margin: 0 0 18px; color: var(--ink-2); line-height: 1.7; max-width: 70ch; }
  .join { padding-bottom: 96px; }
  .jc { padding: 32px; }
  .jf { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
  .jf .field { flex: 1 1 260px; }
  @media (max-width: 760px) { .hist li { grid-template-columns: 1fr; } .hist .y { grid-row: auto; } .cards { grid-template-columns: 1fr; } }
</style>
