<div class="div wrap" aria-hidden="true"><span></span><img src="/emblem.svg" alt="" width="35" height="40" /><span></span></div>
<style>
  .div { display: flex; align-items: center; gap: 20px; margin-block: 24px; }
  .div span { flex: 1; height: 1px; background: var(--line); }
  .div img { height: 40px; width: auto; transition: transform 1s cubic-bezier(.2,1.4,.4,1); }
  .div:hover img { transform: rotate(180deg) scale(1.15); }
  @supports (animation-timeline: view()) { .div img { animation: turn linear both; animation-timeline: view(); animation-range: entry 0% exit 0%; } }
  @keyframes turn { from { transform: rotate(-90deg); } to { transform: rotate(90deg); } }
</style>
