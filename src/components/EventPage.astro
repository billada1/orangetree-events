---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { events, isUpcoming, type EventItem } from '../data/events';
import { artistBySlug } from '../data/artists';
import { photos } from '../data/photos';
import { eventJsonLd } from '../data/schema';
import { posterFor, artistImage } from '../data/media';
import { roleLine } from '../data/roles';
import { googleCalUrl } from '../lib/calendar';
import Signup from './Signup.astro';
import Countdown from './Countdown.astro';
import { t, href, fmtDate, type Lang } from '../i18n/ui';
interface Props { lang: Lang; e: EventItem }
const { lang, e } = Astro.props;
const s = t(lang);
const up = isUpcoming(e);
const poster = posterFor(e, lang);
// The event's own photo, or for NYE a past NYE photo shown as decoration. Other nights without a poster or
// photo get a designed brand header rather than an unrelated stock photo.
const own = e.image ? photos[e.image] : undefined;
const ph = own ?? (e.kind === 'nye' ? photos.nye2023screen : undefined);
const phAlt = own ? own.alt[lang] : '';
const role = roleLine(e, lang);
const performers = (e.artists ?? []).map(artistBySlug).filter(Boolean);
const evLd = eventJsonLd(e, lang, Astro.site!);
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: s.siteName, item: new URL(href(lang, '/'), Astro.site!).href },
  { '@type': 'ListItem', position: 2, name: up ? s.nav.on : s.nav.past, item: new URL(href(lang, up ? '/#whats-on' : '/events/'), Astro.site!).href },
  { '@type': 'ListItem', position: 3, name: e.title[lang], item: new URL(href(lang, `/events/${e.slug}/`), Astro.site!).href },
] };
const ld = evLd ? [evLd, crumbs] : [crumbs];
// Related nights: shared artists first, then the same kind, nearest in time. Internal links for visitors and search.
const k = (x: EventItem) => x.date ?? x.year ?? '';
const shared = (x: EventItem) => (x.artists ?? []).filter((a) => e.artists?.includes(a)).length;
const related = events.filter((x) => x.slug !== e.slug && !x.cancelled && !(x.confirm && !x.date))
  .map((x) => ({ x, score: shared(x) * 10 + (x.kind === e.kind ? 3 : 0) + (x.partner && x.partner === e.partner ? 2 : 0) - Math.abs(Number(k(x).slice(0, 4) || 0) - Number(k(e).slice(0, 4) || 0)) * 0.1 }))
  .filter((r) => r.score > 0).sort((a, b) => b.score - a.score).slice(0, 4).map((r) => r.x);
const when = e.date ? fmtDate(e.date, lang, { weekday: true }) + (e.doors ? ` · ${s.on.doors} ${e.doors.replace(':', lang === 'tr' ? '.' : ':')}` : '') : (e.year ?? s.past.dateToConfirm);
const gcal = up && e.date ? googleCalUrl(e, lang) : null;
const icsHref = href(lang, `/events/${e.slug}.ics`);
const baseDesc = [e.title[lang], when, e.venue, e.note?.[lang]].filter(Boolean).join('. ');
const desc = baseDesc.length >= 70 ? baseDesc : `${baseDesc}. ${lang === 'tr' ? 'Orange Tree Events arşivinden bir gece: 2014’ten beri Sydney’de Türk konserleri, stand-up ve yılbaşı.' : 'A night from the Orange Tree Events archive: Turkish concerts, comedy and New Year’s Eve in Sydney since 2014.'}`;
// Two nights with the same name (e.g. Nida Rock Akustik 2021 and 2024) get the year in the page title.
const sameName = events.filter((x) => x.title[lang] === e.title[lang]).length > 1;
const pageTitle = sameName ? `${e.title[lang]} (${(e.date ?? e.year ?? '').slice(0, 4)})` : e.title[lang];
---
<Base lang={lang} title={pageTitle} description={desc} jsonLd={ld} noindex={!!e.confirm && !e.date}>
  <section class:list={['top', { withPoster: !!poster, plain: !poster && !ph }]}>
    {poster
      ? <Image src={poster} alt="" widths={[240, 480]} sizes="100vw" quality={50} class="bg blur" loading="eager" />
      : ph
        ? <Image src={ph.src} alt={phAlt} widths={[480, 768, 1024, 1600]} sizes="100vw" quality={70} class="bg" loading="eager" fetchpriority="high" />
        : <div class="bg brandbg" aria-hidden="true"></div>}
    <div class="shade" aria-hidden="true"></div>
    <div class="wrap in">
      <div class="txt">
        <p class="eyebrow"><a href={href(lang, up ? '/#whats-on' : '/events/')}>{up ? s.nav.on : s.nav.past}</a> · <span class={`badge badge-${e.kind}`}>{s.kinds[e.kind]}</span></p>
        <h1>{e.title[lang]}</h1>
        <p class="lead">{when}{e.venue && <> · {e.venue}</>}</p>
        {role && <p class="role">{role}</p>}
      </div>
      {poster && (
        <figure class:list={['poster', { off: e.cancelled }]}>
          <Image src={poster} alt={`${lang === 'tr' ? 'Afiş' : 'Poster'}: ${e.title[lang]}${e.cancelled ? (lang === 'tr' ? ' (iptal edildi)' : ' (cancelled)') : ''}`} widths={[360, 540, 800]} sizes="(max-width: 900px) 70vw, 380px" loading="eager" fetchpriority="high" />
          {e.cancelled && <span class="stamp" aria-hidden="true">{lang === 'tr' ? 'İptal' : 'Cancelled'}</span>}
        </figure>
      )}
    </div>
  </section>
  <div class="wrap grid">
    <div>
      {e.note && <p class="lead">{e.note[lang]}</p>}
      {up && e.included && (
        <>
          <h2 class="sub">{lang === 'tr' ? 'Bilete dahil' : 'What’s included'}</h2>
          <ul class="incl">{e.included[lang].map((x) => <li>{x}</li>)}</ul>
        </>
      )}
      {!up && !e.cancelled && <p class="muted">{s.event.past}{e.soldOut && <> · {s.past.soldOut}</>}</p>}
      {e.confirm && <p class="muted">{s.past.confirmNote}</p>}
      {performers.length > 0 && (
        <>
          <h2 class="sub">{s.nav.artists}</h2>
          <ul class="perf">{performers.map((a) => { const im = artistImage(a!); return <li>{im ? <Image src={im.src} alt="" widths={[96, 192]} sizes="48px" class={`pav fp-${a!.slug}`} /> : <span class="pav pav0" aria-hidden="true">{a!.name.replace(/^DJ\s+/i, '').split(/\s+/).map((w) => w[0]).slice(0, 2).join('')}</span>}<span><a href={href(lang, `/artists/${a!.slug}/`)}>{a!.name}</a> <span class="muted">{a!.role[lang]}</span></span></li>; })}</ul>
        </>
      )}
      {e.story && <p><a class="btn btn-ghost" href={href(lang, `/stories/${e.story}/`)}>{s.stories.read}</a></p>}
    </div>
    <aside class="card box">
      <dl>
        <dt>{s.event.when}</dt><dd>{when}</dd>
        {e.venue && <><dt>{s.event.where}</dt><dd>{e.venue}{e.address && <><br /><span class="muted">{e.address}</span></>}</dd></>}
        {role && <><dt>{e.co ? s.event.partnerWith : e.kind === 'supported' || e.kind === 'promotion' ? s.role.org : s.role.with}</dt><dd>{e.partner}</dd></>}
      </dl>
      {gcal && (
        <div class="cal">
          <p class="cal-h"><svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M4 6.5h16v13H4zM4 10.5h16M8 3.5v5M16 3.5v5" /></svg>{s.event.addCal}</p>
          <a class="cal-l" href={icsHref} download={`${e.slug}.ics`} data-cal="ics">{s.event.calIcs}</a>
          <a class="cal-l" href={gcal} rel="noopener" target="_blank" data-cal="google">{s.event.calGoogle} <span aria-hidden="true">↗</span></a>
        </div>
      )}
      {up && e.tickets && (
        <div class="tix">
          {e.tickets.url && e.date && <div class="cdw"><p class="small muted">{lang === 'tr' ? 'Kapıların açılmasına' : 'Doors open in'}</p><Countdown lang={lang} target={`${e.date}T${e.doors ?? '19:00'}:00+11:00`} /></div>}
          <p class="price">{e.tickets.label[lang]}</p>
          {e.tickets.url ? (<>
            <a class="btn btn-primary book" href={e.tickets.url} rel="noopener" data-ticket={e.slug}>{s.event.book} <span aria-hidden="true">↗</span></a>
            <p class="muted small">{s.event.bookVia.replace('{via}', e.tickets.via ?? '')}</p>
            <p class="muted small">{s.event.orNotify}</p>
          </>) : <p class="muted small">{s.event.ticketsSoon}</p>}
          <form action="/api/subscribe/" method="post" class="f">
            <label class="sr-only" for="ev-email">{s.on.email}</label>
            <input id="ev-email" class="field" type="email" name="email" autocomplete="email" required placeholder={s.on.emailPh} />
            <input type="hidden" name="lang" value={lang} /><input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" /><input type="hidden" name="event" value={e.slug} />
            <button class="btn btn-primary" type="submit">{s.on.notify}</button>
          </form>
        </div>
      )}
    </aside>
  </div>
  {!(up && e.tickets) && (
    <div class="wrap sgn"><Signup lang={lang} id="ev-signup" event={e.slug}
      heading={up ? undefined : (lang === 'tr' ? 'Bir dahaki geceyi kaçırmayın' : 'Don’t miss the next one')} /></div>
  )}
  {related.length > 0 && (
    <section class="wrap rel" aria-labelledby="rel-h">
      <h2 id="rel-h" class="sub">{lang === 'tr' ? 'Benzer geceler' : 'More nights like this'}</h2>
      <ul class="rl">
        {related.map((x) => { const p = posterFor(x); return (
          <li><a href={href(lang, `/events/${x.slug}/`)}>
            {p ? <Image src={p} alt="" widths={[160, 320]} sizes="80px" class="rp" /> : <span class="rp rp0" aria-hidden="true"><img src="/emblem.svg" alt="" width="28" height="32" /></span>}
            <span class="rt"><span class="rn">{x.title[lang]}</span><span class="muted">{x.date ? fmtDate(x.date, lang, { year: true }) : x.year}</span></span>
          </a></li>
        ); })}
      </ul>
    </section>
  )}
</Base>
<style>
  .cal { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin: 4px 0 18px; padding: 14px 0 0; border-top: 1px solid var(--line); }
  .cal-h { display: flex; align-items: center; gap: 8px; margin: 0; width: 100%; font-weight: 600; font-size: 15px; color: var(--ink-2); }
  .cal-l { display: inline-flex; align-items: center; min-height: 40px; padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line); font-size: 15px; font-weight: 600; text-decoration: none; transition: border-color .2s, background .2s; }
  .cal-l:hover { border-color: var(--peach); background: #1C1815; }
  .book { display: flex; justify-content: center; width: 100%; margin: 6px 0 10px; }
  .top { position: relative; min-height: 560px; height: 70vh; max-height: 760px; display: flex; align-items: flex-end; overflow: hidden; }
  .top :global(.bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(13,11,10,.55), rgba(13,11,10,.15) 35%, rgba(13,11,10,.95)); }
  .in { position: relative; width: 100%; padding-bottom: 48px; display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; }
  .txt { min-width: 0; }
  .role { margin: 10px 0 0; font-weight: 600; color: var(--peach); }
  .sgn { margin-top: 56px; }
  .cdw { margin-bottom: 16px; } .cdw p { margin: 0 0 8px; }
  .top.plain { min-height: 420px; height: 52vh; }
  .brandbg { background: radial-gradient(120% 90% at 85% 10%, rgba(240,90,40,.45), transparent 60%), radial-gradient(90% 80% at 0% 100%, rgba(191,62,30,.35), transparent 65%), #1A1311; }
  .brandbg::after { content: ''; position: absolute; right: 6%; top: 50%; width: min(34vw, 320px); aspect-ratio: 490 / 566; transform: translateY(-55%); background: url(/emblem.svg) no-repeat center / contain; opacity: .16; }
  @media (max-width: 900px) { .brandbg::after { width: 52vw; right: -6vw; top: 38%; } }
  .top.withPoster { min-height: 680px; height: auto; max-height: none; padding-top: 120px; }
  .top :global(.blur) { filter: blur(40px) saturate(1.3) brightness(.55); transform: scale(1.2); }
  .poster { flex: 0 0 auto; margin: 0 0 8px; transform: rotate(2.5deg); transition: transform .5s cubic-bezier(.2,.8,.2,1); animation: drop-in 1.2s cubic-bezier(.22,1,.36,1) both .2s; }
  .poster:hover { transform: rotate(0) scale(1.02); }
  .poster.off { position: relative; }
  .poster.off :global(img) { filter: saturate(.55) brightness(.8); }
  /* A cancelled night keeps its poster as a record, stamped so its prices and booking link are not taken as live. */
  .stamp { position: absolute; left: 50%; top: 74%; transform: translate(-50%, -50%) rotate(-12deg); padding: 10px 26px; border: 4px solid #fff; border-radius: 10px; background: #BF3E1E; color: #fff; font-family: var(--display); font-weight: 800; font-size: clamp(26px, 3.2vw, 40px); letter-spacing: .08em; text-transform: uppercase; box-shadow: 0 10px 30px rgba(0,0,0,.45); white-space: nowrap; }
  .poster :global(img) { display: block; width: auto; height: auto; max-width: min(380px, 34vw); max-height: min(520px, 58vh); border-radius: 14px; box-shadow: 0 30px 80px rgba(0,0,0,.6), 0 0 0 1px rgba(255,255,255,.08); }
  @keyframes drop-in { from { opacity: 0; transform: translateY(24px) rotate(4deg); } to { opacity: 1; transform: rotate(2.5deg); } }
  @media (max-width: 900px) { .in { flex-direction: column-reverse; align-items: flex-start; padding-top: 110px; } .poster :global(img) { max-width: min(300px, 70vw); max-height: 60vh; } .top.withPoster { height: auto; max-height: none; } }
  @media (prefers-reduced-motion: reduce) { .poster { animation: none; transform: none; } }
  .eyebrow { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  h1 { font-weight: 800; font-size: clamp(40px, 6vw, 88px); max-width: 18ch; }
  .lead { margin-top: 14px; }
  .grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 40px; padding-block: 56px 96px; align-items: start; }
  .sub { font-size: 28px; margin: 32px 0 12px; }
  .perf { list-style: none; padding: 0; margin: 0; } .perf li { display: flex; align-items: center; gap: 14px; padding: 10px 0; border-bottom: 1px solid var(--line); } .perf a { font-weight: 700; }
  .perf :global(.pav) { flex: 0 0 48px; width: 48px; height: 48px; border-radius: 50%; object-fit: cover; }
  .pav0 { display: grid; place-items: center; background: #2A2522; color: var(--peach); font-size: 15px; font-weight: 700; }
  .incl { margin: 0 0 8px; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 8px 20px; }
  .incl li { position: relative; padding-left: 22px; color: var(--ink-2); }
  .incl li::before { content: ''; position: absolute; left: 2px; top: .6em; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  .rel { padding-block: 8px 96px; }
  .rl { list-style: none; margin: 16px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .rl a { display: flex; gap: 14px; align-items: center; padding: 10px; border: 1px solid var(--line); border-radius: 16px; text-decoration: none; transition: border-color .2s, background .2s; height: 100%; }
  .rl a:hover { border-color: var(--peach); background: #1C1815; }
  .rl :global(.rp) { flex: 0 0 64px; width: 64px; height: 80px; object-fit: cover; border-radius: 8px; }
  .rp0 { display: grid; place-items: center; background: #1C1815; } .rp0 img { opacity: .4; }
  .rt { display: flex; flex-direction: column; gap: 2px; min-width: 0; } .rn { font-weight: 600; line-height: 1.3; }
  .box { padding: 24px; }
  dl { margin: 0; } dt { font-size: 13px; color: var(--muted); text-transform: uppercase; letter-spacing: .1em; margin-top: 14px; } dt:first-child { margin-top: 0; } dd { margin: 4px 0 0; font-weight: 600; }
  .tix { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--line); }
  .price { font-family: var(--display); font-weight: 800; font-size: 26px; margin: 0; }
  .small { font-size: 14px; }
  .f { display: flex; flex-wrap: wrap; gap: 8px; } .f .field { flex: 1 1 180px; border-color: var(--line-2); }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
</style>
