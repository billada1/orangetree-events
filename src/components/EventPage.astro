---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { isUpcoming, type EventItem } from '../data/events';
import { artistBySlug } from '../data/artists';
import { photos } from '../data/photos';
import { eventJsonLd } from '../data/schema';
import { posterFor } from '../data/media';
import { roleLine } from '../data/roles';
import { googleCalUrl } from '../lib/calendar';
import { t, href, fmtDate, type Lang } from '../i18n/ui';
interface Props { lang: Lang; e: EventItem }
const { lang, e } = Astro.props;
const s = t(lang);
const up = isUpcoming(e);
const poster = posterFor(e);
const ph = photos[e.image ?? (e.kind === 'nye' ? 'nye2023screen' : 'stageWide')];
const role = roleLine(e, lang);
const performers = (e.artists ?? []).map(artistBySlug).filter(Boolean);
const ld = eventJsonLd(e, lang, Astro.site!);
const when = e.date ? fmtDate(e.date, lang, { weekday: true }) + (e.doors ? ` · ${s.on.doors} ${e.doors.replace(':', lang === 'tr' ? '.' : ':')}` : '') : (e.year ?? s.past.dateToConfirm);
const gcal = up && e.date ? googleCalUrl(e, lang) : null;
const icsHref = href(lang, `/events/${e.slug}.ics`);
const desc = [e.title[lang], when, e.venue, e.note?.[lang]].filter(Boolean).join('. ');
---
<Base lang={lang} title={e.title[lang]} description={desc} jsonLd={ld ?? undefined} noindex={!!e.confirm && !e.date}>
  <section class:list={['top', { withPoster: !!poster }]}>
    {poster
      ? <Image src={poster} alt="" widths={[480, 960]} sizes="100vw" class="bg blur" loading="eager" />
      : <Image src={ph.src} alt={ph.alt[lang]} widths={[640, 1024, 1600]} sizes="100vw" class="bg" loading="eager" fetchpriority="high" />}
    <div class="shade" aria-hidden="true"></div>
    <div class="wrap in">
      <div class="txt">
        <p class="eyebrow"><a href={href(lang, up ? '/#whats-on' : '/events/')}>{up ? s.nav.on : s.nav.past}</a> · <span class={`badge badge-${e.kind}`}>{s.kinds[e.kind]}</span></p>
        <h1>{e.title[lang]}</h1>
        <p class="lead">{when}{e.venue && <> · {e.venue}</>}</p>
        {role && <p class="role">{role}</p>}
      </div>
      {poster && (
        <figure class="poster">
          <Image src={poster} alt={`${lang === 'tr' ? 'Afiş' : 'Poster'}: ${e.title[lang]}`} widths={[360, 540, 800]} sizes="(max-width: 900px) 70vw, 380px" loading="eager" fetchpriority="high" />
        </figure>
      )}
    </div>
  </section>
  <div class="wrap grid">
    <div>
      {e.note && <p class="lead">{e.note[lang]}</p>}
      {!up && <p class="muted">{s.event.past}{e.soldOut && <> · {s.past.soldOut}</>}</p>}
      {e.confirm && <p class="muted">{s.past.confirmNote}</p>}
      {performers.length > 0 && (
        <>
          <h2 class="sub">{s.nav.artists}</h2>
          <ul class="perf">{performers.map((a) => <li><a href={href(lang, `/artists/${a!.slug}/`)}>{a!.name}</a> <span class="muted">{a!.role[lang]}</span></li>)}</ul>
        </>
      )}
      {e.story && <p><a class="btn btn-ghost" href={href(lang, `/stories/${e.story}/`)}>{s.stories.read}</a></p>}
    </div>
    <aside class="card box">
      <dl>
        <dt>{s.event.when}</dt><dd>{when}</dd>
        {e.venue && <><dt>{s.event.where}</dt><dd>{e.venue}{e.address && <><br /><span class="muted">{e.address}</span></>}</dd></>}
        {role && <><dt>{e.co ? s.event.partnerWith : e.kind === 'supported' || e.kind === 'promotion' ? s.role.org : s.role.with}</dt><dd>{e.partner}</dd></>}
      </dl>
      {gcal && (
        <div class="cal">
          <p class="cal-h"><svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M4 6.5h16v13H4zM4 10.5h16M8 3.5v5M16 3.5v5" /></svg>{s.event.addCal}</p>
          <a class="cal-l" href={icsHref} download={`${e.slug}.ics`} data-cal="ics">{s.event.calIcs}</a>
          <a class="cal-l" href={gcal} rel="noopener" target="_blank" data-cal="google">{s.event.calGoogle} <span aria-hidden="true">↗</span></a>
        </div>
      )}
      {up && e.tickets && (
        <div class="tix">
          <p class="price">{e.tickets.label[lang]}</p>
          {e.tickets.url ? (<>
            <a class="btn btn-primary book" href={e.tickets.url} rel="noopener" data-ticket={e.slug}>{s.event.book} <span aria-hidden="true">↗</span></a>
            <p class="muted small">{s.event.bookVia.replace('{via}', e.tickets.via ?? '')}</p>
            <p class="muted small">{s.event.orNotify}</p>
          </>) : <p class="muted small">{s.event.ticketsSoon}</p>}
          <form action="/api/subscribe/" method="post" class="f">
            <label class="sr-only" for="ev-email">{s.on.email}</label>
            <input id="ev-email" class="field" type="email" name="email" autocomplete="email" required placeholder={s.on.emailPh} />
            <input type="hidden" name="lang" value={lang} /><input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" /><input type="hidden" name="event" value={e.slug} />
            <button class="btn btn-primary" type="submit">{s.on.notify}</button>
          </form>
        </div>
      )}
    </aside>
  </div>
</Base>
<style>
  .cal { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin: 4px 0 18px; padding: 14px 0 0; border-top: 1px solid var(--line); }
  .cal-h { display: flex; align-items: center; gap: 8px; margin: 0; width: 100%; font-weight: 600; font-size: 15px; color: var(--ink-2); }
  .cal-l { display: inline-flex; align-items: center; min-height: 40px; padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line); font-size: 15px; font-weight: 600; text-decoration: none; transition: border-color .2s, background .2s; }
  .cal-l:hover { border-color: var(--peach); background: #1C1815; }
  .book { display: flex; justify-content: center; width: 100%; margin: 6px 0 10px; }
  .top { position: relative; min-height: 560px; height: 70vh; max-height: 760px; display: flex; align-items: flex-end; overflow: hidden; }
  .top :global(.bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(13,11,10,.55), rgba(13,11,10,.15) 35%, rgba(13,11,10,.95)); }
  .in { position: relative; width: 100%; padding-bottom: 48px; display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; }
  .txt { min-width: 0; }
  .role { margin: 10px 0 0; font-weight: 600; color: var(--peach); }
  .top.withPoster { min-height: 680px; height: auto; max-height: none; padding-top: 120px; }
  .top :global(.blur) { filter: blur(40px) saturate(1.3) brightness(.55); transform: scale(1.2); }
  .poster { flex: 0 0 auto; margin: 0 0 8px; transform: rotate(2.5deg); transition: transform .5s cubic-bezier(.2,.8,.2,1); animation: drop-in 1.2s cubic-bezier(.22,1,.36,1) both .2s; }
  .poster:hover { transform: rotate(0) scale(1.02); }
  .poster :global(img) { display: block; width: auto; height: auto; max-width: min(380px, 34vw); max-height: min(520px, 58vh); border-radius: 14px; box-shadow: 0 30px 80px rgba(0,0,0,.6), 0 0 0 1px rgba(255,255,255,.08); }
  @keyframes drop-in { from { opacity: 0; transform: translateY(24px) rotate(4deg); } to { opacity: 1; transform: rotate(2.5deg); } }
  @media (max-width: 900px) { .in { flex-direction: column-reverse; align-items: flex-start; padding-top: 110px; } .poster :global(img) { max-width: min(300px, 70vw); max-height: 60vh; } .top.withPoster { height: auto; max-height: none; } }
  @media (prefers-reduced-motion: reduce) { .poster { animation: none; transform: none; } }
  .eyebrow { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  h1 { font-weight: 800; font-size: clamp(40px, 6vw, 88px); max-width: 18ch; }
  .lead { margin-top: 14px; }
  .grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 40px; padding-block: 56px 96px; align-items: start; }
  .sub { font-size: 28px; margin: 32px 0 12px; }
  .perf { list-style: none; padding: 0; margin: 0; } .perf li { padding: 10px 0; border-bottom: 1px solid var(--line); } .perf a { font-weight: 700; }
  .box { padding: 24px; }
  dl { margin: 0; } dt { font-size: 13px; color: var(--muted); text-transform: uppercase; letter-spacing: .1em; margin-top: 14px; } dt:first-child { margin-top: 0; } dd { margin: 4px 0 0; font-weight: 600; }
  .tix { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--line); }
  .price { font-family: var(--display); font-weight: 800; font-size: 26px; margin: 0; }
  .small { font-size: 14px; }
  .f { display: flex; flex-wrap: wrap; gap: 8px; } .f .field { flex: 1 1 180px; border-color: var(--line-2); }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
</style>
