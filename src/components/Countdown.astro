---
import { t, type Lang } from '../i18n/ui';
interface Props { lang: Lang; target: string }
const { lang, target } = Astro.props;
const s = t(lang);
---
<div class="cd" role="timer" aria-label={s.on.countdownLabel} data-countdown={target}>
  {(['d', 'h', 'm', 's'] as const).map((u, i) => (
    <div><span class="n" data-u={u}>–</span><span class="u">{[s.on.days, s.on.hours, s.on.mins, s.on.secs][i]}</span></div>
  ))}
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((el) => {
    const target = Date.parse(el.dataset.countdown!);
    const set = (u: string, v: number) => { const n = el.querySelector(`[data-u="${u}"]`); if (n) n.textContent = String(v).padStart(2, '0'); };
    const tick = () => {
      const ms = Math.max(0, target - Date.now());
      set('d', Math.floor(ms / 864e5)); set('h', Math.floor(ms / 36e5) % 24); set('m', Math.floor(ms / 6e4) % 60); set('s', Math.floor(ms / 1e3) % 60);
    };
    tick(); setInterval(tick, 1000);
  });
</script>
<style>
  .cd { display: flex; gap: 10px; }
  .cd div { flex: 1; min-width: 64px; background: rgba(13,11,10,.55); border: 1px solid var(--line-2); border-radius: 14px; padding: 10px 8px; text-align: center; display: flex; flex-direction: column; }
  .n { font-family: var(--display); font-weight: 800; font-size: 32px; line-height: 1; font-variant-numeric: tabular-nums; }
  .u { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .1em; margin-top: 4px; }
</style>
