---
import { getImage, Picture } from 'astro:assets';
import { photos, heroSlides } from '../data/photos';
import { t, href, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
// Two WebP sizes per slide for the canvas (phones get the smaller one); the first slide is also a real <picture> so the page paints (and ranks) without JavaScript.
const slides = await Promise.all(heroSlides.map(async (h) => {
  const [small, big] = await Promise.all([1100, 1920].map((width) => getImage({ src: photos[h.key].src, width, format: 'webp', quality: 72 })));
  return { src: small.src, big: big.src, cap: h.cap[lang], alt: photos[h.key].alt[lang], px: h.px };
}));
const first = photos[heroSlides[0].key];
---
<div class="intro" data-intro aria-hidden="true">
  <svg viewBox="0 0 200 330" width="190" height="314">
    <defs><linearGradient id="micHandle" x1="0" x2="1" y1="0" y2="0"><stop offset="0" stop-color="#151110" /><stop offset=".45" stop-color="#4A403A" /><stop offset="1" stop-color="#151110" /></linearGradient></defs>
    <circle class="ring r1" cx="100" cy="79" r="62" fill="none" stroke="#EE5A3A" stroke-width="3" />
    <circle class="ring r2" cx="100" cy="79" r="62" fill="none" stroke="#EE5A3A" stroke-width="2" />
    <circle class="ring r3" cx="100" cy="79" r="62" fill="none" stroke="#FFB199" stroke-width="1.5" />
    <g class="handle">
      <rect x="76" y="136" width="48" height="16" rx="4" fill="#2A2522" stroke="#5A504A" />
      <path d="M80 152 H120 L111 312 Q100 322 89 312 Z" fill="url(#micHandle)" />
      <rect x="96" y="190" width="8" height="22" rx="4" fill="#EE5A3A" />
      <path d="M92 318 Q100 330 108 318" fill="none" stroke="#5A504A" stroke-width="3" />
    </g>
    <image class="head" href="/emblem.svg" x="40" y="0" width="120" height="139" />
  </svg>
  <p class="word">Orange Tree Events · Sydney</p>
  <button type="button" class="skip-intro" data-skip-intro tabindex="-1">{s.intro.skip}</button>
</div>

<section class="hero" aria-labelledby="hero-h" data-hero data-slides={JSON.stringify(slides)} data-labels={JSON.stringify({ photo: s.hero.photo, of: s.hero.of, pause: s.hero.pause, play: s.hero.play })}>
  <Picture class="still" src={first.src} alt="" widths={[640, 1024, 1440, 1920]} sizes="100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
  <canvas class="stage" aria-hidden="true"></canvas>
  <div class="shade" aria-hidden="true"></div>
  <div class="wrap content">
    <p class="eyebrow eq-row"><span class="eq" aria-hidden="true"><span></span><span></span><span></span><span></span></span>{s.hero.eyebrow}</p>
    <h1 id="hero-h">{s.tagline}</h1>
    <p class="lead">{s.hero.lead}</p>
    <div class="ctas">
      <a class="btn btn-primary" href="#whats-on">{s.hero.cta}</a>
      <a class="btn btn-ghost" href={href(lang, '/events/')}>{s.nav.past}</a>
    </div>
  </div>
  <div class="wrap ctl">
    <div class="ctl-row">
      <button type="button" class="round" data-prev aria-label={s.hero.prev}>‹</button>
      <button type="button" class="round" data-pause aria-pressed="false">{s.hero.pause}</button>
      <button type="button" class="round" data-next aria-label={s.hero.next}>›</button>
      <div class="dots" role="group" aria-label={s.hero.photo}>
        {slides.map((x, i) => <button type="button" class="dot" data-dot={i} aria-label={`${s.hero.photo} ${i + 1} ${s.hero.of} ${slides.length}: ${x.cap}`} aria-current={i === 0 ? 'true' : undefined}></button>)}
      </div>
    </div>
    <p class="cap" aria-live="polite"><span data-cap>{slides[0].cap}</span></p>
  </div>
</section>

<script>
  import { mountHero } from '../scripts/hero';
  mountHero();
</script>

<style>
  .intro { position: absolute; inset: 0 0 auto 0; height: 100svh; min-height: 640px; max-height: 920px; z-index: 30; background: radial-gradient(circle at 50% 40%, #2A1F19 0%, var(--bg) 68%); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24px; animation: iris 1.1s cubic-bezier(.4,0,.2,1) 2.4s forwards; }
  .intro.gone { display: none; }
  @keyframes iris { to { opacity: 0; transform: scale(1.03); visibility: hidden; } }
  .head { transform-box: fill-box; transform-origin: 50% 60%; animation: drop 1s cubic-bezier(.22,1,.36,1) both; }
  @keyframes drop { from { transform: translateY(-60px) scale(.2); opacity: 0; } to { transform: none; opacity: 1; } }
  .handle { transform-box: fill-box; transform-origin: 50% 0; animation: grow .7s cubic-bezier(.22,1,.36,1) .5s both; }
  @keyframes grow { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  .ring { transform-box: fill-box; transform-origin: center; opacity: 0; animation: ring 1.8s cubic-bezier(.22,1,.36,1) both; }
  .r1 { animation-delay: .8s; } .r2 { animation-delay: 1.1s; } .r3 { animation-delay: 1.4s; }
  @keyframes ring { 0% { transform: scale(.9); opacity: .9; } 100% { transform: scale(2.4); opacity: 0; } }
  .word { margin: 0; font-family: var(--display); font-weight: 700; font-size: 18px; text-transform: uppercase; animation: word 1.1s cubic-bezier(.22,1,.36,1) .9s both; }
  @keyframes word { from { opacity: 0; letter-spacing: .5em; } to { opacity: 1; letter-spacing: .16em; } }
  .skip-intro { position: absolute; bottom: 28px; right: 28px; font: inherit; font-size: 14px; font-weight: 600; color: var(--ink); background: none; border: 1.5px solid var(--line-2); border-radius: 999px; padding: 10px 16px; cursor: pointer; }

  .hero { position: relative; height: 100svh; min-height: 640px; max-height: 920px; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; background: var(--bg); }
  .hero :global(.still), .stage { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero :global(.still img), .hero :global(img.still) { width: 100%; height: 100%; object-fit: cover; }
  .stage { opacity: 0; transition: opacity 1.4s ease; transform-origin: 50% 50%; will-change: transform; }
  .stage.on { opacity: 1; }
  .shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(13,11,10,.85) 0%, rgba(13,11,10,.25) 62%), linear-gradient(180deg, rgba(13,11,10,.55) 0%, rgba(13,11,10,0) 28%, rgba(13,11,10,.95) 100%); }
  .content { position: relative; width: 100%; }
  h1 { font-weight: 700; font-size: clamp(34px, 5vw, 76px); line-height: .98; letter-spacing: .02em; max-width: 18ch; }
  .lead { margin: 20px 0 0; max-width: 560px; font-size: clamp(17px, 1.6vw, 20px); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .eq-row { display: flex; align-items: center; gap: 12px; }
  .eq { display: inline-flex; align-items: flex-end; gap: 3px; height: 22px; }
  .eq span { width: 4px; height: 22px; border-radius: 2px; background: var(--accent); transform-origin: 50% 100%; animation: eq 1.6s ease-in-out infinite alternate; }
  .eq span:nth-child(2) { animation-delay: -.3s; } .eq span:nth-child(3) { animation-delay: -.6s; } .eq span:nth-child(4) { animation-delay: -.15s; }
  /* transform, not height: runs on the compositor instead of re-laying out the page every frame */
  @keyframes eq { from { transform: scaleY(.18); } to { transform: scaleY(1); } }
  .ctl { position: relative; width: 100%; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding-top: 28px; padding-bottom: 28px; }
  .ctl-row { display: flex; align-items: center; gap: 10px; }
  .round { font: inherit; font-size: 14px; font-weight: 600; min-width: 44px; height: 44px; padding: 0 14px; border-radius: 999px; border: 1.5px solid rgba(245,239,232,.45); background: rgba(13,11,10,.45); color: var(--ink); cursor: pointer; }
  .dots { display: flex; align-items: center; gap: 0; margin-left: 4px; }
  /* 24px hit area (WCAG 2.2 target size); the visible dot is drawn inside it. */
  .dot { width: 24px; height: 24px; padding: 0; border: 0; background: none; cursor: pointer; display: grid; place-items: center; transition: width .5s cubic-bezier(.22,1,.36,1); }
  .dot::before { content: ''; width: 10px; height: 10px; border-radius: 999px; background: rgba(245,239,232,.45); transition: width .5s cubic-bezier(.22,1,.36,1), background .5s; }
  .dot[aria-current="true"] { width: 36px; }
  .dot[aria-current="true"]::before { width: 28px; background: var(--accent); }
  .dot:focus-visible { outline: 2px solid var(--peach); outline-offset: 0; border-radius: 999px; }
  .cap { margin: 0; font-size: 13px; color: var(--ink-2); text-align: right; }
  .fx { color: var(--faint); }
  @media (max-width: 760px) { .dots { display: none; } .cap { flex-basis: 100%; text-align: left; } }
  @media (prefers-reduced-motion: reduce) { .intro { display: none; } .eq span { animation: none; transform: scaleY(.6); } }
</style>
