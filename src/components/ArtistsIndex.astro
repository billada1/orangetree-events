---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { artists, type Artist } from '../data/artists';
import { events } from '../data/events';
import { artistImage } from '../data/media';
import { t, href, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const years = (slug: string) => events.filter((e) => e.artists?.includes(slug)).map((e) => e.date?.slice(0, 4) ?? e.year).filter(Boolean).sort();
const byName = (a: Artist, b: Artist) => a.name.localeCompare(b.name, 'tr');
const local = artists.filter((a) => a.local).sort(byName);
const visiting = artists.filter((a) => !a.local).sort(byName);
const groups = [
  { id: 'visiting', h: s.artistsUi.visiting, p: '', list: visiting },
  { id: 'local', h: s.artistsUi.local, p: s.artistsUi.localP, list: local },
];
const initials = (n: string) => n.replace(/^DJ\s+/i, '').split(/[\s&]+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('');
---
<Base lang={lang} title={s.nav.artists} overlayHeader={false}>
  <section class="wrap pg">
    <p class="eyebrow">{s.siteName}</p>
    <h1 class="h2">{s.nav.artists}</h1>
    {groups.map((g) => (
      <section class="grp" aria-labelledby={`g-${g.id}`}>
        <h2 id={`g-${g.id}`}>{g.h}</h2>
        {g.p && <p class="muted">{g.p}</p>}
        <ul class="grid">
          {g.list.map((a) => {
            const img = artistImage(a);
            const y = years(a.slug);
            return (
              <li>
                <a class="card art" href={href(lang, `/artists/${a.slug}/`)}>
                  <span class="pic">
                    {img
                      ? <Image src={img.src} alt="" width={420} height={420} fit="cover" position={img.poster ? 'top' : 'center'} />
                      : <span class="mono" aria-hidden="true">{initials(a.name)}</span>}
                  </span>
                  <span class="meta">
                    <span class="n">{a.name}</span>
                    <span class="muted">{a.role[lang]}{y.length ? ` · ${y[0]}${y.length > 1 && y[y.length - 1] !== y[0] ? `–${y[y.length - 1]}` : ''}` : ''}</span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </section>
</Base>
<style>
  .pg { padding-block: 64px 96px; }
  .grp { margin-top: 48px; }
  .grp h2 { font-size: 28px; margin-bottom: 6px; }
  .grid { list-style: none; padding: 0; margin: 20px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; }
  .art { display: flex; flex-direction: column; overflow: hidden; height: 100%; transition: transform .3s var(--ease), border-color .3s; }
  .art:hover { transform: translateY(-4px); border-color: var(--accent); color: inherit; }
  .pic { aspect-ratio: 1; overflow: hidden; background: radial-gradient(circle at 30% 20%, #3A2018, #14110F 70%); display: grid; place-items: center; }
  .pic :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .art:hover .pic :global(img) { transform: scale(1.06); }
  .mono { font-family: var(--display); font-weight: 800; font-size: 56px; color: var(--accent); letter-spacing: .02em; }
  .meta { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 4px; }
  .n { font-family: var(--display); font-weight: 700; font-size: 18px; }
  .meta .muted { font-size: 14px; }
</style>
