---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import { events, isUpcoming } from '../data/events';
import { artists, type Artist } from '../data/artists';
import { photos } from '../data/photos';
import { artistImage, posterFor } from '../data/media';
import { roleLine } from '../data/roles';
import { t, href, fmtDate, type Lang } from '../i18n/ui';
interface Props { lang: Lang; a: Artist }
const { lang, a } = Astro.props;
const s = t(lang);
const P = s.artistPage;

const key = (e: { date?: string; year?: string }) => e.date ?? e.year ?? '';
const shows = events.filter((e) => e.artists?.includes(a.slug)).sort((x, y) => key(y).localeCompare(key(x)));
const upcoming = shows.filter((e) => isUpcoming(e)).sort((x, y) => key(x).localeCompare(key(y)));
const firstYear = shows.map((e) => key(e).slice(0, 4)).filter(Boolean).sort()[0];
const img = artistImage(a);
const ph = img && !img.poster ? img.src : null;
const posterImg = img?.poster ? img.src : null;
// Press photos are often under 1100px wide: show them crisp in a frame over a soft blur of the same photo instead of stretching them full-bleed.
const framed = !!ph && ph.width < 1100;
const wide = !!ph && ph.width / ph.height > 1.3;

// Gallery: own photos first, then every poster from their shows.
type G = { src: ImageMetadata; alt: string; poster: boolean };
const gal: G[] = [
  ...(a.gallery ?? []).filter((k) => photos[k]).map((k) => ({ src: photos[k].src, alt: photos[k].alt[lang], poster: false })),
  ...shows.filter((e) => posterFor(e)).map((e) => ({ src: posterFor(e)!, alt: `${lang === 'tr' ? 'Afiş' : 'Poster'}: ${e.title[lang]}`, poster: true })),
];
const galFull = await Promise.all(gal.map((g) => getImage({ src: g.src, width: Math.min(1600, g.src.width), format: 'webp' })));

const yt = a.youtube ? `https://www.youtube-nocookie.com/embed/videoseries?list=UU${a.youtube.slice(2)}` : null;
const sp = a.spotify ? `https://open.spotify.com/embed/artist/${a.spotify}?theme=0` : null;
const q = encodeURIComponent(a.name);
const wikiLang = a.wiki?.[lang] ? lang : a.wiki?.en ? 'en' : a.wiki?.tr ? 'tr' : null;
const wikiUrl = wikiLang ? `https://${wikiLang}.wikipedia.org/wiki/${encodeURIComponent(a.wiki![wikiLang]!.replace(/ /g, '_'))}` : null;
const creditUrl = a.credit ? `https://commons.wikimedia.org/wiki/File:${encodeURIComponent(a.credit.file.replace(/ /g, '_'))}` : null;

const kindLabel = (k: string) => (s.kinds as Record<string, string>)[k] ?? '';
const others = artists.filter((x) => x.slug !== a.slug && x.local === a.local);
const more = [...others.filter((x) => artistImage(x)), ...others.filter((x) => !artistImage(x))].slice(0, 10);
const initials = (n: string) => n.replace(/^DJ\s+/i, '').split(/[\s&]+/).filter(Boolean).slice(0, 2).map((w) => w[0].toLocaleUpperCase('tr')).join('');

const sections = [
  a.bio && { id: 'about', label: s.artist.about },
  (sp || yt || !a.local) && { id: 'listen', label: P.listen },
  shows.length > 0 && { id: 'shows', label: s.artist.withUs },
  gal.length > 0 && { id: 'photos', label: P.gallery },
].filter(Boolean) as { id: string; label: string }[];

const desc = a.bio?.[lang][0] ?? `${a.name} · ${a.role[lang]} · ${s.siteName}`;
const sameAs = [
  a.instagram && `https://www.instagram.com/${a.instagram}/`,
  a.spotify && `https://open.spotify.com/artist/${a.spotify}`,
  a.youtube && `https://www.youtube.com/channel/${a.youtube}`,
  wikiUrl,
].filter(Boolean);
const ld = {
  '@context': 'https://schema.org', '@type': a.slug === 'manga' || /band|grup|duo|ikili/i.test(a.role.en) ? 'MusicGroup' : 'Person',
  name: a.name, description: desc, url: new URL((lang === 'tr' ? '/tr' : '') + `/artists/${a.slug}/`, Astro.site!).href,
  ...(sameAs.length ? { sameAs } : {}),
};
---
<Base lang={lang} title={a.name} description={desc} jsonLd={ld} overlayHeader={!!(ph || posterImg)} noindex={!a.bio && shows.length === 0}>
  <section class:list={['top', { plain: !ph && !posterImg }]}>
    {ph && !framed && <Image src={ph} alt={a.name} widths={[640, 1024, 1600]} sizes="100vw" class={`bg fp-${a.slug}`} loading="eager" fetchpriority="high" />}
    {framed && <Image src={ph!} alt="" widths={[320]} sizes="100vw" class="bg blur" loading="eager" />}
    {posterImg && <Image src={posterImg} alt="" widths={[480, 960]} sizes="100vw" class="bg blur" loading="eager" />}
    {(ph || posterImg) && <div class="shade" aria-hidden="true"></div>}
    <div class="wrap in">
      <div class="hd">
        <p class="eyebrow"><a href={href(lang, '/artists/')}>{s.nav.artists}</a> · {a.local ? s.artistsUi.local : s.artistsUi.visiting}</p>
        <h1 class:list={['name', { keep: /[a-z][A-Z]/.test(a.name) }]}>{a.name}</h1>
        <p class="role">{a.role[lang]}</p>
        {shows.length > 0 && (
          <ul class="chips" role="list">
            <li>{P.nights(shows.length)}</li>
            {firstYear && <li>{P.since(firstYear)}</li>}
          </ul>
        )}
        <div class="acts">
          {upcoming[0] && <a class="btn btn-primary" href={href(lang, `/events/${upcoming[0].slug}/`)}>{P.next}: {fmtDate(upcoming[0].date!, lang)} →</a>}
          <a class:list={['btn', upcoming[0] ? 'btn-ghost' : 'btn-primary']} href="#notify">{s.artist.notify}</a>
          <span class="soc">
            {a.instagram && <a href={`https://www.instagram.com/${a.instagram}/`} rel="noopener" target="_blank" aria-label={`Instagram @${a.instagram}`}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" class="f"/></svg></a>}
            {a.spotify && <a href={`https://open.spotify.com/artist/${a.spotify}`} rel="noopener" target="_blank" aria-label="Spotify"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M7.5 9.5c3-1 6.5-.7 9 .8M8 12.6c2.5-.7 5.2-.4 7.3.8M8.6 15.4c2-.5 4-.3 5.6.6"/></svg></a>}
            {a.youtube && <a href={`https://www.youtube.com/channel/${a.youtube}`} rel="noopener" target="_blank" aria-label="YouTube"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10 9.2v5.6l4.8-2.8z" class="f"/></svg></a>}
            {wikiUrl && <a href={wikiUrl} rel="noopener" target="_blank" aria-label="Wikipedia"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h4M9 6h4M15 6h6M4.5 6l4 12 3.5-9 3.5 9 4-12"/></svg></a>}
          </span>
        </div>
      </div>
      {framed && <figure class:list={['portrait', { wide }]}><Image src={ph!} alt={a.name} class={`fp-${a.slug}`} widths={[360, 640]} sizes="(max-width: 900px) 70vw, 360px" loading="eager" fetchpriority="high" /></figure>}
      {posterImg && <figure class="poster"><Image src={posterImg} alt={`${a.name}: ${lang === 'tr' ? 'afiş' : 'poster'}`} widths={[360, 540]} sizes="(max-width: 900px) 60vw, 320px" loading="eager" /></figure>}
    </div>
  </section>

  {sections.length > 1 && (
    <nav class="sub" aria-label={P.jump}>
      <div class="wrap"><ul>{sections.map((x) => <li><a href={`#${x.id}`}>{x.label}</a></li>)}</ul></div>
    </nav>
  )}

  <div class="wrap body">
    {a.bio && (
      <section id="about" class="about reveal" aria-labelledby="ab-h">
        <div>
          <h2 id="ab-h" class="h3">{s.artist.about}</h2>
          {a.bio[lang].map((p, i) => <p class:list={['lead', { first: i === 0 }]}>{p}</p>)}
          {(wikiUrl || a.credit || a.official || a.own) && (
            <p class="src">
              {wikiUrl && <>{P.source}: <a href={wikiUrl} rel="noopener" target="_blank">Wikipedia</a></>}
              {wikiUrl && a.credit && ' · '}
              {a.credit && <>{P.photoBy}: <a href={creditUrl!} rel="noopener" target="_blank">{a.credit.by}</a>, {a.credit.licence}</>}
              {a.own && !a.credit && <>{wikiUrl && ' · '}{lang === 'tr' ? 'Fotoğraf: Orange Tree Events' : 'Photo: Orange Tree Events'}</>}
              {a.official && !a.credit && <>{wikiUrl && ' · '}{lang === 'tr' ? 'Fotoğraf: sanatçının resmî basın fotoğrafı' : 'Photo: official artist press photo'}</>}
            </p>
          )}
        </div>
        {a.facts && <dl class="facts">{a.facts.map((f) => <div><dt>{f.label[lang]}</dt><dd>{f.value}</dd></div>)}</dl>}
      </section>
    )}

    {(sp || yt || !a.local) && (
      <section id="listen" class="reveal" aria-labelledby="li-h">
        <h2 id="li-h" class="h3">{P.listen}</h2>
        <div class="players">
          {sp ? (
            <div class="player sp" data-src={sp} data-title={`${a.name} on Spotify`} data-h="352">
              <div class="ph">
                <svg viewBox="0 0 24 24" aria-hidden="true" class="logo"><circle cx="12" cy="12" r="9"/><path d="M7.5 9.5c3-1 6.5-.7 9 .8M8 12.6c2.5-.7 5.2-.4 7.3.8M8.6 15.4c2-.5 4-.3 5.6.6"/></svg>
                <p class="pt">{P.spotify}</p>
                <button type="button" class="btn btn-light load">▶ {P.load}</button>
                <p class="note">{P.loadsFrom('Spotify')} <a href={`https://open.spotify.com/artist/${a.spotify}`} rel="noopener" target="_blank">{P.openIn('Spotify')} ↗</a></p>
              </div>
            </div>
          ) : (
            <a class="player sp link" href={`https://open.spotify.com/search/${q}`} rel="noopener" target="_blank"><div class="ph"><p class="pt">{P.search('Spotify')} ↗</p></div></a>
          )}
          {yt ? (
            <div class="player yt" data-src={yt} data-title={`${a.name} on YouTube`} data-h="352">
              <div class="ph">
                <svg viewBox="0 0 24 24" aria-hidden="true" class="logo"><rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10 9.2v5.6l4.8-2.8z" class="f"/></svg>
                <p class="pt">{P.youtube}</p>
                <button type="button" class="btn btn-light load">▶ {P.load}</button>
                <p class="note">{P.loadsFrom('YouTube')} <a href={`https://www.youtube.com/channel/${a.youtube}`} rel="noopener" target="_blank">{P.openIn('YouTube')} ↗</a></p>
              </div>
            </div>
          ) : (
            <a class="player yt link" href={`https://www.youtube.com/results?search_query=${q}`} rel="noopener" target="_blank"><div class="ph"><p class="pt">{P.search('YouTube')} ↗</p></div></a>
          )}
        </div>
      </section>
    )}

    {shows.length > 0 && (
      <section id="shows" class="reveal" aria-labelledby="sh-h">
        <h2 id="sh-h" class="h3">{s.artist.withUs}</h2>
        <ol class="tl">
          {shows.map((e) => {
            const pf = posterFor(e);
            const rl = roleLine(e, lang);
            return (
              <li class="card">
                <a class="pf" href={href(lang, `/events/${e.slug}/`)} tabindex="-1" aria-hidden="true">
                  {pf ? <Image src={pf} alt="" widths={[200, 400]} sizes="160px" /> : <span class="mono">{initials(a.name)}</span>}
                </a>
                <div class="tx">
                  <p class="d">{e.date ? fmtDate(e.date, lang, { weekday: true }) : (e.year ?? s.past.dateToConfirm)}{isUpcoming(e) && <span class="up">{s.on.onSale}</span>}</p>
                  <h3><a href={href(lang, `/events/${e.slug}/`)}>{e.title[lang]}</a></h3>
                  {e.venue && <p class="muted">{e.venue}</p>}
                  <p class="tags"><span class="tag">{kindLabel(e.kind)}</span>{rl && <span class="muted">{rl}</span>}{e.soldOut && <span class="tag so">{s.past.soldOut}</span>}</p>
                  <p class="btns">
                    <a class="btn btn-ghost btn-sm" href={href(lang, `/events/${e.slug}/`)}>{P.details}</a>
                    {e.story && <a class="btn btn-ghost btn-sm" href={href(lang, `/stories/${e.story}/`)}>{s.stories.read}</a>}
                  </p>
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    )}

    {gal.length > 0 && (
      <section id="photos" class="reveal" aria-labelledby="ga-h">
        <h2 id="ga-h" class="h3">{P.gallery}</h2>
        <ul class="strip" role="list">
          {gal.map((g, i) => (
            <li>
              <button type="button" class:list={['thumb', { poster: g.poster }]} data-i={i} aria-label={g.alt}>
                <Image src={g.src} alt="" widths={[320, 560]} sizes="(max-width: 760px) 70vw, 300px" />
              </button>
            </li>
          ))}
        </ul>
        <p class="muted small">{s.moments.removeQ} <a class="u" href="mailto:info@orangetree.events?subject=Photo%20removal">{s.moments.remove}</a></p>
        <dialog class="lb" aria-label={P.gallery}>
          <div class="lb-in">
            <button type="button" class="lb-x" aria-label={P.close}>✕</button>
            <button type="button" class="lb-p" aria-label={P.prev}>‹</button>
            <figure><img alt="" decoding="async" /><figcaption></figcaption></figure>
            <button type="button" class="lb-n" aria-label={P.next2}>›</button>
          </div>
          <script type="application/json" class="lb-data" set:html={JSON.stringify(galFull.map((f, i) => ({ src: f.src, alt: gal[i].alt })))} />
        </dialog>
      </section>
    )}

    <form id="notify" class="notify reveal" action="/api/subscribe/" method="post">
      <div><h2 class="h3">{s.artist.notifyH(a.name)}</h2><p>{s.artist.notifyP}</p></div>
      <div class="f"><label class="sr-only" for="ar-email">{s.on.email}</label><input id="ar-email" class="field" type="email" name="email" autocomplete="email" required placeholder={s.on.emailPh} /><input type="hidden" name="lang" value={lang} /><input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" /><input type="hidden" name="artist" value={a.slug} /><button class="btn btn-dark" type="submit">{s.artist.notify}</button></div>
    </form>

    <nav aria-labelledby="more-h" class="more">
      <div class="mh"><h2 id="more-h" class="h3">{s.artist.more}</h2><a href={href(lang, '/artists/')}>{s.nav.artists} →</a></div>
      <ul class="mrow" role="list">
        {more.map((x) => {
          const im = artistImage(x);
          return (
            <li><a href={href(lang, `/artists/${x.slug}/`)} class="mc">
              {im ? <Image src={im.src} alt="" widths={[240, 400]} sizes="200px" class={`fp-${x.slug}`} /> : <span class="mono">{initials(x.name)}</span>}
              <span class="mn">{x.name}</span><span class="mr muted">{x.role[lang]}</span>
            </a></li>
          );
        })}
      </ul>
    </nav>
  </div>
</Base>

<script>
  // Click-to-load players: nothing from Spotify or YouTube loads until asked.
  document.querySelectorAll<HTMLElement>('.player[data-src]').forEach((box) => {
    box.querySelector('.load')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = box.dataset.src!;
      f.title = box.dataset.title ?? '';
      f.height = box.dataset.h ?? '352';
      f.loading = 'lazy';
      f.allow = 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture';
      f.referrerPolicy = 'strict-origin-when-cross-origin';
      box.replaceChildren(f);
      box.classList.add('on');
    });
  });

  // Lightbox for the photo and poster strip.
  const dlg = document.querySelector<HTMLDialogElement>('dialog.lb');
  if (dlg) {
    const data: { src: string; alt: string }[] = JSON.parse(dlg.querySelector('.lb-data')!.textContent || '[]');
    const im = dlg.querySelector('img')!;
    const cap = dlg.querySelector('figcaption')!;
    let i = 0;
    let opener: HTMLElement | null = null;
    const show = (n: number) => { i = (n + data.length) % data.length; im.src = data[i].src; im.alt = data[i].alt; cap.textContent = `${data[i].alt} · ${i + 1} / ${data.length}`; };
    document.querySelectorAll<HTMLButtonElement>('.thumb').forEach((b) => b.addEventListener('click', () => { opener = b; show(Number(b.dataset.i)); dlg.showModal(); }));
    dlg.querySelector('.lb-x')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('.lb-p')!.addEventListener('click', () => show(i - 1));
    dlg.querySelector('.lb-n')!.addEventListener('click', () => show(i + 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(i - 1); if (e.key === 'ArrowRight') show(i + 1); });
    dlg.addEventListener('close', () => opener?.focus());
    let x0 = 0;
    dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) show(i + (dx < 0 ? 1 : -1)); });
  }
</script>

<style>
  .top { position: relative; min-height: 640px; height: 88vh; max-height: 900px; display: flex; align-items: flex-end; overflow: hidden; }
  .top.plain { min-height: 0; height: auto; padding-top: 96px; background: radial-gradient(120% 90% at 80% 0%, rgba(240,90,40,.28), transparent 60%); }
  .top :global(.bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 25%; animation: kb 24s ease-out both; }
  @keyframes kb { from { transform: scale(1.05); } to { transform: scale(1); } }
  .top :global(.blur) { filter: blur(40px) saturate(1.3) brightness(.5); animation: none; transform: scale(1.2); }
  .shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(13,11,10,.92), rgba(13,11,10,.25) 62%), linear-gradient(180deg, rgba(13,11,10,.55), transparent 30%, rgba(13,11,10,.97)); }
  .in { position: relative; width: 100%; padding-bottom: 56px; display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; }
  .hd { max-width: 760px; }
  .name { font-weight: 800; font-size: clamp(54px, 9vw, 140px); line-height: .88; letter-spacing: .02em; animation: nm 1.4s cubic-bezier(.22,1,.36,1) both; }
  @keyframes nm { from { transform: translateY(16px); opacity: .001; } to { transform: none; opacity: 1; } }
  .name.keep { text-transform: none; }
  .load { background: #fff; color: #111; border: 0; font-weight: 700; }
  .load:hover, .load:focus-visible { background: var(--accent); color: var(--accent-ink); }
  .role { margin: 14px 0 0; font-size: clamp(17px, 1.6vw, 21px); color: var(--ink-2); }
  .chips { list-style: none; padding: 0; margin: 18px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li { border: 1px solid rgba(255,255,255,.22); background: rgba(255,255,255,.06); backdrop-filter: blur(6px); border-radius: 999px; padding: 7px 14px; font-size: 14px; font-weight: 600; }
  .acts { margin-top: 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .soc { display: inline-flex; gap: 6px; margin-left: 4px; }
  .soc a { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; border: 1px solid rgba(255,255,255,.25); transition: background .2s, transform .2s; }
  .soc a:hover, .soc a:focus-visible { background: var(--accent); border-color: var(--accent); transform: translateY(-2px); }
  svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; } svg .f { fill: currentColor; stroke: none; }
  .portrait { flex: 0 0 auto; width: min(360px, 32vw); margin: 0; animation: nm 1.6s cubic-bezier(.22,1,.36,1) .15s both; }
  .portrait :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; border-radius: 22px; box-shadow: 0 40px 100px rgba(0,0,0,.6), 0 0 0 1px rgba(255,255,255,.08); }
  .portrait.wide { width: min(560px, 42vw); }
  .portrait.wide :global(img) { aspect-ratio: auto; }
  @media (max-width: 760px) { .in:has(.portrait) { flex-direction: column-reverse; align-items: flex-start; } .portrait { width: min(300px, 70vw); } }
  .poster { flex: 0 0 auto; width: min(320px, 30vw); margin: 0; transform: rotate(-2deg); }
  .poster :global(img) { display: block; width: auto; max-width: 100%; max-height: min(460px, 55vh); border-radius: 14px; box-shadow: 0 30px 80px rgba(0,0,0,.6); }

  .sub { position: sticky; top: 0; z-index: 20; background: rgba(13,11,10,.86); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .sub ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; }
  .sub a { display: block; padding: 16px 14px; font-family: var(--display); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; font-size: 14px; color: var(--ink-2); white-space: nowrap; border-bottom: 2px solid transparent; }
  .sub a:hover, .sub a:focus-visible { color: var(--ink); border-color: var(--accent); }
  section[id] { scroll-margin-top: 72px; }

  .body { display: flex; flex-direction: column; gap: 88px; padding-block: 72px 96px; }
  .h3 { font-size: clamp(30px, 3.4vw, 44px); font-weight: 700; margin-bottom: 22px; }
  .about { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(260px, 1fr); gap: 56px; align-items: start; }
  .about .lead { margin: 0 0 18px; font: 400 19px/1.7 var(--serif); color: #E9E1D8; max-width: 68ch; }
  .about .lead.first { font-size: 23px; line-height: 1.55; color: var(--ink); }
  .src { font-size: 14px; color: var(--muted); } .src a { color: var(--coral); text-decoration: underline; }
  .facts { margin: 0; border-radius: 20px; background: var(--card, rgba(255,255,255,.04)); border: 1px solid var(--line); padding: 8px 22px; position: sticky; top: 84px; }
  .facts div { padding: 14px 0; border-bottom: 1px solid var(--line); } .facts div:last-child { border-bottom: 0; }
